datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  VT
}

enum RequestStatus {
  Pending
  Approved
  Rejected
  Completed
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  password   String   // Hashed with bcrypt
  name       String
  role       Role     @default(VT)
  roleLabel  String?
  department String?
  trade      String?
  schoolName String?
  udiseCode  String?
  mobile     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

model GuestLecturer {
  id            String   @id @default(uuid())
  name          String
  organization  String
  designation   String
  phone         String
  email         String?
  qualification String?
  location      String?
  trade         String   @default("General")
  tradeKeywords String   @default("") // Comma-separated tags
  isVerified    Boolean  @default(true)
  addedBy       String   @default("System")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("guest_lecturers")
}

model Requisition {
  id              String        @id // e.g. GLR-2026-001
  district        String
  mandal          String
  village         String
  schoolName      String
  udiseCode       String
  trade           String
  tradeCode       String?
  vtName          String
  vtMobile        String
  lectureDate     String        // YYYY-MM-DD
  topic           String?
  status          RequestStatus @default(Pending)
  assignedSpeaker String?       @default("")
  notes           String?       @default("")
  submittedAt     DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([district])
  @@index([lectureDate])
  @@map("requisitions")
}
